# Base URL of the LP deployment (no trailing slash).
# Production: https://go.forlex.ai
LP_BASE_URL=https://go.forlex.ai

# PostHog — same project/host as forlex.site (EU residency via reverse proxy).
# Get the key from Vercel env of forlex.site (NUXT_PUBLIC_POSTHOG_KEY) or PostHog dashboard.
LP_POSTHOG_KEY=
LP_POSTHOG_HOST=https://b.forlex.ai

# Meta Pixel ID for campaign attribution (Events Manager → Data Sources).
# Leave empty to skip fbq injection (QA will warn, not fail).
LP_META_PIXEL_ID=

# Robots directive injected at build time.
# ENG-4705: sources ship with `noindex`. Keep `noindex` until João confirms indexation.
# Allowed: `noindex` | `index`
LP_ROBOTS=noindex

# Set to `true` to disable all tracking injection (local dev without keys).
LP_DISABLE_TRACKING=false
